# ── Citizen-Service Agent · environment variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
CLAUDE_MODEL=claude-sonnet-4-5

# ── Modes ─────────────────────────────────────────────────────────────────────
# LLM_MODE: live | stub  (stub uses a deterministic scripted adapter for tests)
LLM_MODE=live

# EXTRACTION_MODE: vision | sidecar  (sidecar reads the *_good.json sidecars)
EXTRACTION_MODE=vision

# TEST_MODE: 0 | 1  (1 = frozen clock, immediate portal outcomes, auto-consent)
TEST_MODE=0

# BENCHMARK_MODE: 0 | 1  (must be 1 to enable ABLATE_* flags)
BENCHMARK_MODE=0

# Ablation flags – only meaningful when BENCHMARK_MODE=1
ABLATE_RECOVERY=0
ABLATE_CODE_CONSENT=0
ABLATE_RULES=0

# ── Portal ────────────────────────────────────────────────────────────────────
PORTAL_BASE_URL=http://localhost:8001
# PORTAL_FAIL_MODE: none | random | down | slow | reject_income | fail_n:<k>
PORTAL_FAIL_MODE=none
PORTAL_SEED=42

# ── Speech ────────────────────────────────────────────────────────────────────
# WHISPER_MODE: local | api | browser
WHISPER_MODE=browser

# ── Optional regional languages (STRETCH) ─────────────────────────────────────
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=

# ── Auth ──────────────────────────────────────────────────────────────────────
HELPER_TOKEN=demo-helper-token-change-me

# ── Payments ──────────────────────────────────────────────────────────────────
# Secret token for bank/UPI PSP webhook settlement verification
PAYMENT_WEBHOOK_SECRET=demo-webhook-secret-key-12345
# Secret admin key for operator settlement confirmation & testing
PAYMENT_ADMIN_KEY=demo-admin-key-67890

# ── Dates ─────────────────────────────────────────────────────────────────────
# REFERENCE_DATE: ISO date used as "today" for document generation and frozen clock.
# Leave blank to use the real today.
# REFERENCE_DATE=2026-10-07
